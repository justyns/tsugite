{
  "name": "tsugite-daemon-frontend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json && vitest run --project unit && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "knip": "knip"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7",
    "@types/node": "^26.1.1",
    "@vitest/browser": "^4",
    "@vitest/browser-playwright": "^4.1.10",
    "knip": "^6.27.0",
    "playwright": "^1",
    "prettier": "^3",
    "prettier-plugin-svelte": "^4",
    "svelte": "^5",
    "svelte-check": "^4",
    "typescript": "^5",
    "vite": "^8",
    "vitest": "^4",
    "vitest-browser-svelte": "^3"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5",
    "@fontsource/jetbrains-mono": "^5",
    "@xterm/addon-fit": "^0.11",
    "@xterm/xterm": "^6",
    "marked": "^18"
  }
}
